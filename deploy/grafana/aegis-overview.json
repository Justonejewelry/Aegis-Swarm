{
  "title": "AEGIS Swarm Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Findings by severity",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "rawSql": "SELECT severity, count(*) FROM findings GROUP BY severity ORDER BY 2 DESC",
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top risk findings",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "rawSql": "SELECT title, severity, risk_score, created_at FROM findings ORDER BY risk_score DESC LIMIT 20",
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Findings over time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, count(*) FROM findings GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    }
  ]
}
