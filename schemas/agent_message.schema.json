{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/agent_message.schema.json",
  "title": "AEGISAgentMessage",
  "type": "object",
  "required": ["message_id", "correlation_id", "engagement_id", "sender", "recipient", "msg_type", "priority", "payload", "timestamp", "signature"],
  "properties": {
    "message_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "engagement_id": { "type": "string", "format": "uuid" },
    "sender": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,64}$" },
    "recipient": { "type": "string" },
    "msg_type": {
      "type": "string",
      "enum": ["task", "result", "finding", "alert", "heartbeat", "consensus", "audit", "control"]
    },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "payload": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "mitre_techniques": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
